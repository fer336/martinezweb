---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCta from '../components/FinalCta.astro';
import WaIcon from '../components/WaIcon.astro';
import site from '../data/site.json';
import { withBase } from '../lib/url.js';

const servicios = [
  'Destapaciones de cañerías y desagües',
  'Reparación de pérdidas de agua',
  'Instalación de sanitarios y griferías',
  'Obra nueva y reformas de baño y cocina',
];
const senales = [
  'Manchas de humedad en paredes, techos o pisos.',
  'Un desagüe o cañería que drena cada vez más lento, o directamente se tapó.',
  'Una canilla o conexión que gotea o pierde agua de forma constante.',
  'Estás planeando una reforma o remodelación de baño o cocina.',
];
const faqs = [
  { q: '¿Hacen trabajos de obra nueva, no solo reparaciones?', a: 'Sí, hacemos instalación completa de cañerías y sanitarios en obra nueva y reformas de baño y cocina, además de reparaciones puntuales.' },
  { q: '¿Cuánto tarda una destapación?', a: 'Depende de dónde esté la obstrucción, pero la mayoría se resuelven en la misma visita.' },
  { q: '¿Atienden fuera de Pinamar?', a: 'Sí: Cariló, Valeria del Mar, Ostende y Costa Esmeralda.' },
];
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const wa = `https://wa.me/${site.whatsapp}?text=Hola,%20necesito%20un%20plomero`;
---
<BaseLayout
  title="Plomero en Pinamar · Martínez Gas-Plomería"
  description="Plomero en Pinamar: destapaciones, reparación de pérdidas de agua, instalación de sanitarios y griferías, obra nueva y reformas de baño y cocina."
  jsonld={faqJsonLd}
>
  <section style="background:var(--bg);border-bottom:1px solid #ebebe6">
    <div class="wrap-narrow" style="display:flex;flex-direction:column;gap:16px">
      <nav style="font-size:13px;color:#888;display:flex;gap:8px"><a href={withBase('/')} style="color:#888">Inicio</a><span>/</span><span style="color:#111;font-weight:600">Plomero</span></nav>
      <span class="tag">PERSONAL MATRICULADO</span>
      <h1 style="font-size:clamp(30px,4.4vw,46px);line-height:1.08;text-wrap:pretty">Plomero en Pinamar</h1>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#444;text-wrap:pretty">Destapaciones, reparación de pérdidas de agua, instalación de sanitarios y griferías, y obra nueva o reformas de baño y cocina en Pinamar y la Costa.</p>
      <a href={wa} target="_blank" rel="noopener" class="btn btn-primary" style="align-self:flex-start;font-size:15px;padding:14px 22px"><WaIcon size={17} />Consultar por WhatsApp</a>
    </div>
  </section>
  <section>
    <div class="wrap-narrow" style="display:flex;flex-direction:column;gap:40px">
      <div style="display:flex;flex-direction:column;gap:14px">
        <h2 style="font-size:26px">Qué hacemos</h2>
        <div style="display:flex;flex-direction:column;gap:8px">
          {servicios.map(x => (<div style="display:flex;gap:12px;align-items:baseline;background:var(--bg);border-radius:8px;padding:14px 18px"><span style="color:var(--yellow-ink);font-weight:700;flex:none">—</span><span style="font-size:15px;line-height:1.5">{x}</span></div>))}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:14px">
        <h2 style="font-size:26px">Señales de que necesitás un plomero</h2>
        <div style="display:flex;flex-direction:column;gap:8px">
          {senales.map(x => (<div style="display:flex;gap:12px;align-items:baseline;background:var(--bg);border-radius:8px;padding:14px 18px"><span style="color:var(--yellow-ink);font-weight:700;flex:none">—</span><span style="font-size:15px;line-height:1.5">{x}</span></div>))}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <h2 style="font-size:26px">Preguntas frecuentes</h2>
        {faqs.map(f => (<details style="padding:16px 20px"><summary style="font-size:15px"><span>{f.q}</span><span class="faq-chev">+</span></summary><p style="margin:10px 0 0;font-size:14.5px;line-height:1.6;color:#555">{f.a}</p></details>))}
      </div>
    </div>
  </section>
  <FinalCta title="¿Necesitás un plomero?" text="Escribinos por WhatsApp y contanos qué necesitás. Te respondemos y coordinamos la visita." msg="Hola,%20necesito%20un%20plomero" />
</BaseLayout>
